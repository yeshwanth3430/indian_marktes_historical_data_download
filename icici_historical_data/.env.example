# Copy this file to .env and replace the ****** with your own ICICI Direct
# Breeze credentials. .env is git-ignored — never commit real values.

# From https://api.icicidirect.com/apiuser/home (App details)
BREEZE_API_KEY=******
BREEZE_API_SECRET=******

# Expires daily. Print the login URL with
#   python -c "import icici_config; print(icici_config.login_url())"
# then log in and copy the API_Session value out of the redirect URL.
BREEZE_SESSION_TOKEN=******

# Optional — override the DuckDB output paths
# NIFTY_DB_PATH=nifty_data.duckdb
# SENSEX_DB_PATH=sensex_data.duckdb

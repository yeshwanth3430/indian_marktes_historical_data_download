# Copy this file to .env and fill in your own ICICI Direct Breeze credentials.
# .env is git-ignored — never commit real values.

# From https://api.icicidirect.com/apiuser/home (App details)
BREEZE_API_KEY=your_api_key_here
BREEZE_API_SECRET=your_api_secret_here

# Expires daily. Open the login URL printed on startup, log in, then copy the
# API_Session value out of the redirect URL.
BREEZE_SESSION_TOKEN=your_session_token_here

# Optional — override the DuckDB output paths
# NIFTY_DB_PATH=nifty_data.duckdb
# SENSEX_DB_PATH=sensex_data.duckdb

# Copy this file to .env and replace the ****** with your own GDFL API keys.
# .env is git-ignored — never commit real values.

# NSE key — exchanges NFO + NSE_IDX (NIFTY, BANKNIFTY, FINNIFTY, MIDCPNIFTY)
GDFL_NSE_API_KEY=******

# BSE key — exchanges BFO + BSE_IDX (SENSEX, BANKEX)
GDFL_BSE_API_KEY=******

# Optional — override the GDFL websocket host
# GDFL_WS_ENDPOINT=ws://nimblewebstream.lisuns.com:4575/
